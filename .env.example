# ==============================================================================
# PETPREV — ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Sistema de Saúde Preventiva Domiciliar (Produção & Desenvolvimento)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO & SERVIDOR NESTJS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS POSTGRESQL 16 + POSTGIS
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=petprev_db
POSTGRES_USER=petprev_admin
POSTGRES_PASSWORD=petprev_super_secret_db_pass_change_me
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 3. REDIS 7 (CACHE & FILAS BULLMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=petprev_redis_secret_pass_change_me
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ------------------------------------------------------------------------------
# 4. ARMAZENAMENTO S3 (MINIO LOCAL)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_petprev_admin
MINIO_ROOT_PASSWORD=minio_super_secret_storage_pass_change_me
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Buckets do MinIO
MINIO_BUCKET_COLDCHAIN=petprev-coldchain
MINIO_BUCKET_RECORDS=petprev-records
MINIO_BUCKET_CARTEIRAS=petprev-vaccine-cards
MINIO_BUCKET_AVATARS=petprev-avatars

# ------------------------------------------------------------------------------
# 5. AUTENTICAÇÃO JWT & CICLO DE VIDA OTP
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=petprev_access_token_jwt_secret_key_change_me_in_prod_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=petprev_refresh_token_jwt_secret_key_change_me_in_prod_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Parâmetros de OTP (Passwordless via SMS/WhatsApp)
OTP_TTL_SECONDS=180
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 6. MENSAGERIA WHATSAPP (EVOLUTION API)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_api_global_secret_key_change_me
EVOLUTION_INSTANCE_NAME=petprev_whatsapp_instance

# ------------------------------------------------------------------------------
# 7. TELEORIENTAÇÃO WEBRTC (LIVEKIT)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://livekit.petprev.local
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_change_me_in_production
LIVEKIT_ROOM_DURATION_MINUTES=20
LIVEKIT_RECORDING_ENABLED=false

# ------------------------------------------------------------------------------
# 8. GATEWAY DE PAGAMENTOS & ASSINATURAS (ASAAS)
# ------------------------------------------------------------------------------
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=asaas_api_key_test_or_prod_token
ASAAS_WEBHOOK_TOKEN=asaas_webhook_verification_token_secret

# ------------------------------------------------------------------------------
# 9. ROTINA DE BACKUP OFFSITE
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/petprev
BACKUP_S3_REMOTE=remote_backup:petprev-backups
BACKUP_RETENTION_DAYS=7
